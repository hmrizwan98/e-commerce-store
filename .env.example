# Firebase client SDK config (safe to expose to the browser)
# Firebase Console -> Project settings -> General -> Your apps -> Web app -> SDK setup and configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK service account (server-only, never expose to the browser)
# Firebase Console -> Project settings -> Service accounts -> Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private_key value from the downloaded JSON, keep the \n escape sequences literal.
FIREBASE_PRIVATE_KEY=

# Local file under public/images - leave unset to use the built-in default.
NEXT_PUBLIC_PLACEHOLDER_IMAGE_URL=/images/placeholder.png

# Cloudinary (image storage/CDN) - https://cloudinary.com/console
# Cloud name is not secret; API key/secret are server-only, never exposed
# to the browser. See src/lib/cloudinary/.
CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Multi-tenant: production resolves the tenant from the request subdomain
# (see middleware.ts). Locally there's no wildcard DNS, so set this to an
# existing store's slug to develop against it.
DEV_TENANT_SLUG=

# The root domain new stores' default subdomain/admin URLs are generated
# under, e.g. "myplatform.com" -> {slug}.myplatform.com. Used by the Super
# Admin "Create store" action. Stores can additionally resolve on their own
# custom domain(s) by adding them to a store's `domains[]` - see the Domain
# Strategy section in README.md.
#
# Optional - if left unset, src/lib/platform/base-url.ts auto-detects the
# platform's real base URL instead of using a placeholder: it falls back to
# Vercel's own auto-provided deployment URL (VERCEL_PROJECT_PRODUCTION_URL/
# VERCEL_URL - no manual setup needed on Vercel), then to
# http://localhost:{PORT ?? 3000} for local dev.
NEXT_PUBLIC_ROOT_DOMAIN=
